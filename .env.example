TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
FLASK_ENV=development
FLASK_DEBUG=0
API_HOST=0.0.0.0
API_PORT=5001
DATABASE_PATH=backend/data/moodfix.db

# Solo hacen falta en produccion (Render), para que los datos de usuario
# sobrevivan a cada redeploy sin pagar un disco persistente. En local se
# puede dejar vacio: el backend cae automaticamente en DATABASE_PATH.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
